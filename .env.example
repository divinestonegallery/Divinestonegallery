# Final public website origin used for canonical URLs, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://divinestonegallery.com

# Local monorepo service addresses. The browser continues to use /api/v1;
# the frontend proxies those requests to the backend service.
FRONTEND_URL=http://127.0.0.1:3000
BACKEND_API_URL=http://127.0.0.1:3001

# Hosting target for release validation: vercel or aws.
DEPLOYMENT_TARGET=vercel

# PostgreSQL. On Vercel, use the pooled Neon/serverless connection URL.
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_SSL=require

# ImageKit media storage. Copy these from ImageKit -> Developer options.
# IMAGEKIT_PRIVATE_KEY must remain server-only.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# Optional S3-compatible fallback. S3_ENDPOINT is optional for AWS S3.
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_USE_IAM_ROLE=false
S3_SERVER_SIDE_ENCRYPTION=AES256

# Non-secret business identity used by server-rendered communications.
BUSINESS_NAME=Divine Stone Gallery
BUSINESS_EMAIL=divinestonegallery@gmail.com
BUSINESS_PHONE_E164=+919166138566
BUSINESS_COUNTRY_CODE=IN
BUSINESS_CURRENCY=INR
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_GSTIN=
CUSTOMER_CARE_HOURS=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_EMAIL=
GRIEVANCE_PHONE_E164=
READY_MADE_RETURN_WINDOW_DAYS=
DAMAGE_REPORT_WINDOW_HOURS=

# Clerk handles all authentication. The application does not issue a custom JWT.
# Copy the publishable and secret keys from the same Clerk production instance.
# CLERK_SECRET_KEY and the webhook signing secret must remain server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
INITIAL_ADMIN_EMAILS=divinestonegallery@gmail.com

# Automatic India delivery rates through a dedicated Shiprocket API user.
# Keep these server-only. Prefer email/password so the server can refresh the 10-day token.
SHIPROCKET_API_EMAIL=
SHIPROCKET_API_PASSWORD=
SHIPROCKET_API_TOKEN=
SHIPROCKET_PICKUP_POSTCODE=

# Razorpay Standard Checkout for India. Start with Test Mode keys.
# Only the Key ID is returned to the browser; both secrets stay server-only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional email through a verified Resend sending domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Divine Stone Gallery <notifications@divinestonegallery.com>
RESEND_REPLY_TO=divinestonegallery@gmail.com

# India transactional SMS through approved MSG91 DLT flows.
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_SMS_TEMPLATE_MAP_JSON={"order_placed":"","payment_captured":"","commission_submitted":"","commission_quote_ready":"","commission_status_updated":"","commission_milestone_ready":""}

# Official Meta WhatsApp Cloud API with approved utility templates.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_TEMPLATE_MAP_JSON={"order_placed":"","payment_captured":"","commission_submitted":"","commission_quote_ready":"","commission_status_updated":"","commission_milestone_ready":""}

# High-entropy bearer secret used only by the scheduled notification worker.
# Vercel Cron automatically sends CRON_SECRET. AWS uses NOTIFICATION_WORKER_SECRET.
CRON_SECRET=
NOTIFICATION_WORKER_SECRET=

# Local/CI test override only. Leave unset for normal development and production.
TEST_BASE_URL=
