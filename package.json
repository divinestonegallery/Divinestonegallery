{
  "name": "divine-stone-gallery-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/run-workspaces.mjs dev",
    "dev:frontend": "npm run dev --workspace @divine-stone/frontend",
    "dev:backend": "npm run dev --workspace @divine-stone/backend",
    "build": "node --env-file-if-exists=.env.local scripts/run-workspaces.mjs build",
    "build:frontend": "npm run build --workspace @divine-stone/frontend",
    "build:backend": "npm run build --workspace @divine-stone/backend",
    "start": "node --env-file-if-exists=.env.local scripts/run-workspaces.mjs start",
    "test": "npm run build && node scripts/run-tests.mjs",
    "lint": "eslint apps packages scripts tests --ignore-pattern .next",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs generate --config packages/database/drizzle.config.ts",
    "deploy:check": "node --env-file-if-exists=.env.local scripts/check-deployment.mjs",
    "release:verify": "npm run deploy:check && npm run check:boundaries && npm test && npm run lint",
    "db:migrate": "node --env-file-if-exists=.env.local ./node_modules/drizzle-kit/bin.cjs migrate --config packages/database/drizzle.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "^16.3.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.21.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3"
  },
  "type": "module"
}
